    "#%lld goes into %@ on GitHub now (%@). %@ is kept, here and on GitHub." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#%1$lld goes into %2$@ on GitHub now (%3$@). %4$@ is kept, here and on GitHub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ GitHub で #%1$lld を「%3$@」で %2$@ にマージします。%4$@ ブランチは残ります（ローカルにも GitHub にも）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在就在 GitHub 上用「%3$@」把 #%1$lld 合进 %2$@。%4$@ 分支会保留（本地和 GitHub 上都不删）。"
          }
        }
      }

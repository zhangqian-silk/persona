    "Pushes only when a run decides you need to know and alerts you; otherwise it stays quiet. Errors and interruptions are pushed as usual. These tasks always run in their own chat, and messages you send in that chat aren't pushed when done either." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushes only when a run decides you need to know and alerts you; otherwise it stays quiet. Errors and interruptions are pushed as usual. These tasks always run in their own chat, and messages you send in that chat aren't pushed when done either."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行時にあなたが知るべきだと判断して通知した場合のみプッシュし、何もなければ邪魔しません。エラーや中断は通常どおりプッシュします。このタスクは常に専用のチャットで実行され、そのチャットで送ったメッセージも完了時にプッシュされません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有这次运行判断你需要知道、主动提醒你时才推送，没事就不打扰；出错、被打断照常推送。这种任务固定在它自己的对话里跑，你在那段对话里发的消息做完也不推送。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Pushes only when it alerts you" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushes only when it alerts you"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知時のみプッシュ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在提醒时推送"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Pushes the answer to your phone after every run." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushes the answer to your phone after every run."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行が終わるたびに回答をスマートフォンにプッシュします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次运行完都把回答推送到手机。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Pushing" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pushing"
          }
        },

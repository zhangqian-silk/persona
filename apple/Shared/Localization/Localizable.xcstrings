          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你确认过的所有电脑；工作电脑要单独加上才用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

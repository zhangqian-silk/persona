    "A card per agent, its state's color down the side; the one waiting for you is tinted." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A card per agent, its state's color down the side; the one waiting for you is tinted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个 Agent 一张卡片，左边一条状态色；等你处理的那张整张淡蓝底。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントごとに 1 枚のカード。左端に状態の色があり、あなたを待つカードは色付きです。"
          }
        }
      }
    },
    "A card still unanswered after this long gets one reply under it in Lark (in a group topic it mentions you), outside your quiet hours" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A card still unanswered after this long gets one reply under it in Lark (in a group topic it mentions you), outside your quiet hours"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードがこの時間たっても未回答なら、その下に一度だけ返信でお知らせします（グループのトピックではあなたにメンションします）。おやすみ時間中は終了後に送ります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片等这么久还没回答，就在它下面回复提醒一次（话题群里会 @ 你），免打扰时段内顺延到结束后"
          }
        }
      },
      "extractionState" : "manual"
    },

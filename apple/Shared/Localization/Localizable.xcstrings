    "“%@”\\nYour message wasn’t sent so it wouldn’t merge with this text. Clear it on the computer and send?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”\\nYour message wasn’t sent so it wouldn’t merge with this text. Clear it on the computer and send?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」\\nこのテキストとつながらないよう、メッセージはまだ送信していません。コンピューター上のこのテキストを消去して送信しますか？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

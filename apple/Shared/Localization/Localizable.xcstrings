    },
    "After the hub updates, your computers keep their personad version unless auto_update_nodes is on in hub.json. To update one, tap it and choose Redeploy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the hub updates, your computers keep their personad version unless auto_update_nodes is on in hub.json. To update one, tap it and choose Redeploy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブを更新しても、各コンピューターのpersonadは元のバージョンのままです（hub.jsonでauto_update_nodesがオンの場合を除く）。更新するには、そのコンピューターをタップして「再デプロイ」を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub 更新后，各台电脑上的 personad 保持原来的版本，除非 hub.json 里开了 auto_update_nodes；要更新哪台，点进去选「重新部署」。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "After updating, pinned chats show up and your current Lark account syncs." : {
      "localizations" : {

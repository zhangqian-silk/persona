          }
        }
      },
      "extractionState" : "manual"
    },
    "The API credentials and sign-in saved on the hub will be deleted, and this device's session with %@ will end too. You'll need to sign in again to use it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API credentials and sign-in saved on the hub will be deleted, and this device's session with %1$@ will end too. You'll need to sign in again to use it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブに保存されたAPI認証情報とログイン状態は削除され、%1$@側のこのデバイスのセッションも終了します。再度使うにはログインし直す必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub 上存的 API 凭据和登录状态都会删掉，%1$@ 那边这个设备会话也会结束。再用要重新登录。"
          }

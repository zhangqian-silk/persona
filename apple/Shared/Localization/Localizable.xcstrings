    "The hub keeps only the reference and fetches the key from its provider when it's needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub keeps only the reference and fetches the key from its provider when it's needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブは参照だけを保存し、キーが必要になったときに提供元から取得します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub 只保存引用，需要 Key 时再从它的提供方取。"
          }
        }
      }
    },
    "The hub keeps only the reference and fetches the key from its provider when it's needed. The key is handed to the computer only at launch and never sent back to apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub keeps only the reference and fetches the key from its provider when it's needed. The key is handed to the computer only at launch and never sent back to apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブは参照だけを保存し、キーが必要になったときに提供元から取得します。キーは起動時にのみそのコンピューターへ渡され、クライアントには返されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub 只保存引用，需要 Key 时再从它的提供方取；启动时才交给那台电脑，不会返回到客户端。"
          }
        }
      }
    },
    "The hub machine runs the node directly." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub machine runs the node directly."

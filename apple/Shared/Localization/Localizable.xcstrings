    "Members: %@. Pack Only keeps them. Everything also uninstalls them and deletes their settings and data." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Members: %1$@. Pack Only keeps them. Everything also uninstalls them and deletes their settings and data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メンバー：%1$@。「パックのみ」ではメンバーは残ります。「メンバーも」ではメンバーもアンインストールされ、その設定とデータが削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成员：%1$@。「只卸载合集」会保留这些成员；「也卸载成员」会把它们一起卸载，并删除它们的设置和数据。"
          }
        }
      }
    },
    "Members: %@. Uninstalling only the pack keeps them. Uninstalling with members deletes their settings and data." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Members: %1$@. Uninstalling only the pack keeps them. Uninstalling with members deletes their settings and data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成员：%1$@。只卸载合集会保留这些成员；连成员一起卸载会删除它们的设置和数据。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メンバー：%1$@。パックのみアンインストールするとメンバーは残ります。メンバーごとアンインストールすると、メンバーの設定とデータが削除されます。"
          }
        }
      }
    },

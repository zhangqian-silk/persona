    "Either way, the main conversation still runs on one of your computers: an API key alone, with no computer, can't start it yet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Either way, the main conversation still runs on one of your computers: an API key alone, with no computer, can't start it yet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらの場合も、メインの会話はあなたのコンピュータのどれかで動きます。コンピュータをつながずに API キーだけでは、まだ始められません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不管哪一种，现在主对话都还要在你的一台电脑上运行：只粘贴 API Key、不接电脑，还开始不了。"
          }
        }
      },
      "extractionState" : "manual"
    },

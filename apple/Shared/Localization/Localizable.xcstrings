    "Another way to reach this same hub, such as a public domain when the paired address is a VPN one. Fill in both Cloudflare Access fields only if this address is behind Access; the token is sent to this address only." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another way to reach this same hub, such as a public domain when the paired address is a VPN one. Fill in both Cloudflare Access fields only if this address is behind Access; the token is sent to this address only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ hub に届く別の経路です（ペアリングしたアドレスが VPN のものなら公開ドメインなど）。Cloudflare Access のトークンは、このアドレスが Access の背後にあるときだけ両方の欄に入力してください。このアドレスにだけ送られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接同一个 hub 的另一条路，比如配对地址走 VPN 时再加一个公网域名。只有这个地址在 Cloudflare Access 后面时才需要填令牌，两项都要填；令牌只发给这个地址。"
          }
        }
      }
    },
    "Another way to reach this same hub, such as a public domain when the paired address is a VPN one. Fill in the Cloudflare Access token only if this address is behind Access; it's sent to this address only." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another way to reach this same hub, such as a public domain when the paired address is a VPN one. Fill in the Cloudflare Access token only if this address is behind Access; it's sent to this address only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ hub に届く別の経路です（ペアリングしたアドレスが VPN のものなら公開ドメインなど）。Cloudflare Access のトークンは、このアドレスが Access の背後にあるときだけ入力してください。このアドレスにだけ送られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接同一个 hub 的另一条路，比如配对地址走 VPN 时再加一个公网域名。只有这个地址在 Cloudflare Access 后面时才需要填令牌，令牌只发给这个地址。"
          }
        }
      }
    },

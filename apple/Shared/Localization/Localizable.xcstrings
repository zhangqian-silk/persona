    "Hosts or domains, separated by commas; .example.com covers its subdomains. Only these skip this proxy: the list on this computer is for its own proxy." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts or domains, separated by commas; .example.com covers its subdomains. Only these skip this proxy: the list on this computer is for its own proxy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト名またはドメインをカンマで区切って入力します。.example.com はサブドメインも含みます。このプロキシを通らないのはここに入力したものだけです。このコンピューターのリストは、コンピューター自身のプロキシ用です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机名或域名，用逗号分隔；.example.com 包括它的子域名。只有这些地址不走这个代理：电脑上的列表是给它自己的代理用的。"
          }
        }
      }
    },
    "Hosts or domains, separated by commas; .example.com covers its subdomains. They go direct along with the ones this computer already lists." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts or domains, separated by commas; .example.com covers its subdomains. They go direct along with the ones this computer already lists."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト名またはドメインをカンマで区切って入力します。.example.com はサブドメインも含みます。このコンピューターに既にあるリストと合わせて適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机名或域名，用逗号分隔；.example.com 包括它的子域名。会和这台电脑已有的列表一起生效。"
          }
        }
      }
    },

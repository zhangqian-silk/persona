      "extractionState" : "manual"
    },
    "The hub at %@ treats connections through the proxy as coming from the internet and refuses plain HTTP from there. Enter the hub's address inside its LAN or VPN." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub at %1$@ treats connections through the proxy as coming from the internet and refuses plain HTTP from there. Enter the hub's address inside its LAN or VPN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@のハブはプロキシ経由の接続をインターネットからのものとみなし、平文のHTTPを拒否します。LANまたはVPN内でのハブのアドレスを入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 上的 hub 把经代理来的连接当作来自公网，拒绝这类明文 HTTP。请填 hub 在局域网或 VPN 内的地址。"
          }
        }
      }
    },
    "The hub calls a direct API itself; the computers here can get the key too." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub calls a direct API itself; the computers here can get the key too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接 API 由 hub 自己调用；这里的电脑也能拿到 Key。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接 API はハブが自分で呼び出します。ここのコンピューターもキーを受け取れます。"
          }
        }
      }
    },
    "The hub calls the model directly. Available for uses like triage, translation, and knowledge processing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub calls the model directly. Available for uses like triage, translation, and knowledge processing."
          }

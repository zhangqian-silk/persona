    "A reminder goes off when you cross this circle. Indoors your phone's location is often 50–100 m off, so a smaller circle can miss." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reminder goes off when you cross this circle. Indoors your phone's location is often 50–100 m off, so a smaller circle can miss."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この円を出入りしたときにリマインダーが通知されます。屋内では位置が 50〜100 m ずれることが多いため、小さい円だと通知されないことがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进出这个圆圈时提醒会响。在室内，手机定位常有 50–100 米的偏差，圈太小可能会错过。"
          }
        }
      },
      "extractionState" : "manual"
    },

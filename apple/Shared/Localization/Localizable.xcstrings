        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已经不在了，下拉刷新看看。"
          }
        }
      }
    },
    "It leaves the meeting's material and the minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It leaves the meeting's material and the minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会从会议资料和纪要中去掉。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議の資料と議事録から外します。"
          }
        }
      }
    },
    "It may be a binary file, a permissions-only change, or a change that was undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may be a binary file, a permissions-only change, or a change that was undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイナリファイル、権限のみの変更、または取り消された変更の可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能是二进制文件、只改了权限，或者改动已被撤销。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It may have been closed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may have been closed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じられた可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能已经关掉了。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It may have been deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may have been deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除された可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能被删了。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It may have been removed elsewhere, or it waited too long to be confirmed. To add a computer, start again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may have been removed elsewhere, or it waited too long to be confirmed. To add a computer, start again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の場所で削除されたか、確認を待つ時間が長すぎた可能性があります。コンピュータを追加するには、もう一度追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可能在别处被删掉了，或者等确认等得太久。要加电脑，重新添加一次。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It may have expired. Check the main window." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may have expired. Check the main window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限切れの可能性があります。メインウインドウを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能已经过期，回到主窗口看看。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It may have reached the computer already. Check the chat before sending it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may have reached the computer already. Check the chat before sending it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでにコンピューターに届いている可能性があります。チャットを確認してから再送するか決めてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能已经送到电脑上了：先看看对话里有没有，再决定要不要重发"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It may not have been sent: once connected to the hub, check before deciding whether to send it again" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may not have been sent: once connected to the hub, check before deciding whether to send it again"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信されていない可能性があります：hub に接続してから確認し、再送するか決めてください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能没发出去：连上 hub 后看一眼再决定要不要重发"
          }
        }
      }
    },
    "It merges once its checks and reviews pass" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It merges once its checks and reviews pass"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックとレビューが通るとマージされます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查和评审通过后会自动合并"
          }
        }
      }
    },
    "It no longer merges by itself" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It no longer merges by itself"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ではマージしなくなりました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再自动合并"
          }
        }
      }
    },
    "It now has its own credentials, which you can revoke on their own in the device list." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It now has its own credentials, which you can revoke on their own in the device list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには専用の認証情報が発行され、デバイス一覧で個別に取り消せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它已经有了自己的凭据，可以在设备列表里单独撤销。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It reads files and runs commands on your computer, and asks you before it acts" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It reads files and runs commands on your computer, and asks you before it acts"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータ上でファイルを読んだりコマンドを実行したりし、実行前に確認します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在你的电脑上看文件、跑命令，动手前先问你"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It records all the sound around you, other people included. Ask them first: some places require everyone's consent." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It records all the sound around you, other people included. Ask them first: some places require everyone's consent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会录下你身边的所有声音，包括其他人说的话。请先征得他们同意：有些地方要求所有人都同意。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周りのすべての音を、他の人の声も含めて録音します。先に相手の同意を得てください。全員の同意が必要な場所もあります。"
          }
        }
      }
    },
    "It records the whole day, and your hub writes a recap of it every evening." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It records the whole day, and your hub writes a recap of it every evening."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会录下一整天，hub 每晚据此写出当日回顾。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日中録音し、ハブが毎晩その日のまとめを作成します。"
          }
        }
      }
    },
    "It stays open; nothing merges until you merge it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays open; nothing merges until you merge it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オープンのままです。あなたがマージするまでマージされません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会保持开启；你不合并就不会合并。"
          }
        }
      }
    },
    "It will run without asking again. You can stop it any time." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will run without asking again. You can stop it any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后运行它不会再问你，随时可以取消。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後は確認せずに実行します。いつでも取り消せます。"
          }
        }
      }
    },
    "It will stop passing messages to Persona, and pending answers and questions are cleared. To use it again, bind it again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will stop passing messages to Persona, and pending answers and questions are cleared. To use it again, bind it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除するとPersonaにメッセージを渡さなくなり、待機中の回答と質問も消去されます。再び使うにはもう一度紐づけてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除后它不再把消息交给 Persona，在等的回答和提问一起清掉。再用要重新绑定。"
          }

    "Messages go to the main chat (/new, /list to switch threads); replies come back to Lark" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages go to the main chat (/new, /list to switch threads); replies come back to Lark"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージはメインチャットに送られ（/new、/listで切り替え）、返答はLarkに返されます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

          }
        }
      }
    },
    "Enter an address compatible with the selected protocol. The hub keeps only the reference and fetches the key from its provider when it's needed. Choose Bearer if the gateway only accepts Authorization: Bearer (ANTHROPIC_AUTH_TOKEN)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter an address compatible with the selected protocol. The hub keeps only the reference and fetches the key from its provider when it's needed. Choose Bearer if the gateway only accepts Authorization: Bearer (ANTHROPIC_AUTH_TOKEN)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したプロトコルに対応するアドレスを入力してください。ハブは参照だけを保存し、キーが必要になったときに提供元から取得します。ゲートウェイがAuthorization: Bearer（ANTHROPIC_AUTH_TOKEN）のみ受け付ける場合はBearerを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写所选协议兼容的地址。hub 只保存引用，需要 Key 时再从它的提供方取。网关只认 Authorization: Bearer（ANTHROPIC_AUTH_TOKEN）时选 Bearer。"
          }
        }
      }
    },

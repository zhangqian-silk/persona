      "extractionState" : "manual"
    },
    "The tab's name in herdr. If left empty, a short English name is made from the first message (like fix-login); with no first message it's agent-1, agent-2…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tab's name in herdr. If left empty, a short English name is made from the first message (like fix-login); with no first message it's agent-1, agent-2…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "herdrでのこのタブの名前です。空欄の場合は最初のメッセージから短い英語名（例：fix-login）を付け、最初のメッセージがなければagent-1、agent-2…になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "herdr 里这个标签页的名字。不填时按第一条消息起一个短英文名（比如 fix-login），没有第一条消息就叫 agent-1、agent-2…"
          }
        }
      },
      "extractionState" : "manual"
    },

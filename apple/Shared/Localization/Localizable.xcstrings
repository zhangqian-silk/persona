      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a market's address: an https://… index, github:owner/repo (a private repo needs a read-only token; a public one is rate-limited less by GitHub with one) or git:… (uses the hub machine's SSH credentials)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マーケットのアドレスを入力します：https://…のインデックス、github:owner/repo（プライベートリポジトリには読み取り専用トークンが必要。公開リポジトリでもトークンがあればGitHubのレート制限を受けにくくなります）、またはgit:…（ハブのマシンのSSH認証情報を使用）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填一个市场的地址：https://… 的索引、github:owner/repo（私有仓库要一个只读 token，公开的填了也不容易被 GitHub 限流），或 git:…（用 hub 机器的 SSH 凭据）。"
          }
        }
      },
      "extractionState" : "manual"
    },

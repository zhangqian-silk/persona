    "Blocked by rule %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocked by rule %1$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルール%1$@でブロック"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由规则 %1$@ 屏蔽"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Blocked folders aren't scanned or remembered, and their sessions don't appear in Agents (the files aren't touched). Unblock to bring them back. Useful for automation that runs claude with its own CLAUDE_CONFIG_DIR. The default folder can't be blocked." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocked folders aren't scanned or remembered, and their sessions don't appear in Agents (the files aren't touched). Unblock to bring them back. Useful for automation that runs claude with its own CLAUDE_CONFIG_DIR. The default folder can't be blocked."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックしたフォルダはスキャンも記録もされず、その中のセッションはAgentsに表示されません（ファイルはそのまま）。ブロックを解除すると元に戻ります。専用のCLAUDE_CONFIG_DIRでclaudeを動かす自動化スクリプト向けです。デフォルトのフォルダはブロックできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被屏蔽的目录不再扫描、不再记住，里面的会话不出现在 Agents（文件不动）；取消屏蔽后恢复。适合用单独 CLAUDE_CONFIG_DIR 跑 claude 的自动化脚本。默认目录不能屏蔽。"
          }
        }
      },
      "extractionState" : "manual"
    },

    "Need Session Triage on. Continuing and waking run the agent on its own model; pushing, deploying and messaging people always wait for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need Session Triage on. Continuing and waking run the agent on its own model; pushing, deploying and messaging people always wait for you."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションのトリアージがオンのときだけ動きます。続行と起床はエージェント自身のモデルでもう 1 ターン実行します。プッシュ・デプロイ・他の人へのメッセージは必ずあなたを待ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要先打开会话分诊。自动继续和到点叫醒会让 Agent 用自己的模型再跑一轮；推代码、部署、给别人发消息一律等你。"
          }
        }
      }
    },

    },
    "Only sites and counts are listed, never cookie contents. Imported files are read on this machine, and only the sites you check go through the hub straight to the target machine. The hub keeps nothing, and the assistant can't see or import them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only sites and counts are listed, never cookie contents. Imported files are read on this machine, and only the sites you check go through the hub straight to the target machine. The hub keeps nothing, and the assistant can't see or import them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイトと件数のみを表示し、Cookieの内容は表示しません。インポートしたファイルはこのマシン上で解析され、選択したサイトだけがハブ経由で対象のマシンに直接送られます。ハブには保存されず、アシスタントが閲覧やインポートをすることもできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只列网站和条数，不显示 cookie 的内容。导入的文件就在本机解析，只把你勾选的网站经 hub 直接发给目标机器，hub 不保存；助手看不到也导不了。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Only sites and counts are listed, never cookie contents. Imported files are read on your phone, and only the sites you check go through the hub straight to this Mac. The hub keeps nothing, and the assistant can't see or import them." : {
      "localizations" : {

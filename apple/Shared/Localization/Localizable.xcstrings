        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームに「メッセージ」を追加し、すべての個別チャットとグループチャットを表示します。受信トレイとアカウントやチャット履歴を共有します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在首页增加「消息」入口，查看全部私聊和群聊。与收件箱共用账号和聊天记录。"

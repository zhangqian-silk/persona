    "%@ was deleted on the remote: pushing creates it again from %@. Never forced: if the remote has newer commits, the push stops and says so." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ was deleted on the remote: pushing creates it again from %2$@. Never forced: if the remote has newer commits, the push stops and says so."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はリモートで削除されています。プッシュすると %2$@ から作り直します。強制プッシュはしません。リモートに新しいコミットがあれば止めて知らせます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远端已删除 %1$@：推送会用 %2$@ 重新建它。不会强制推送：远端有更新的提交时会停下并说明。"
          }
        }
      }
    },

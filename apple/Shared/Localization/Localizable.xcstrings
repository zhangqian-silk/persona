    "You agreed to these when installing. If a new version asks for more, you'll be asked again before the update." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You agreed to these when installing. If a new version asks for more, you'll be asked again before the update."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール時にこれらに同意しています。新しいバージョンがより多くを求める場合は、アップデート前に再度確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装时你同意过这些；新版本要得更多时，升级前会再问一次。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "You asked on %@:" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You asked on %1$@:"

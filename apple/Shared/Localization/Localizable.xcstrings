    "For watching a computer's screen on mobile data or a personal hotspot. On Wi-Fi the picture is always as clear as the connection allows, and with Low Data Mode on it always saves data." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For watching a computer's screen on mobile data or a personal hotspot. On Wi-Fi the picture is always as clear as the connection allows, and with Low Data Mode on it always saves data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モバイルデータ通信やインターネット共有でコンピュータの画面を見るときに使います。Wi-Fi では回線が許す限り高画質で表示し、低データモードがオンのときは常にデータを節約します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在移动数据或个人热点上看电脑屏幕时用。连着 Wi-Fi 时画面总是按网络撑得住的最清晰来；系统开了「低数据模式」时总是省流量。"
          }
        }
      }
    },

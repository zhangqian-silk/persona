    "Turn on “Organize knowledge points by topic” in Settings › Knowledge Selection, and Persona starts curating in the background." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on “Organize knowledge points by topic” in Settings › Knowledge Selection, and Persona starts curating in the background."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「设置 › 知识选择」里打开「按主题整理知识点」，Persona 就会在后台开始整理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定 › ナレッジの選択」で「ナレッジポイントをトピックごとに整理」をオンにすると、Persona がバックグラウンドで整理を始めます。"
          }
        }
      }
    },
    "Open Knowledge Selection" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Knowledge Selection"
          }
        },

    },
    "It conflicts with %@: resolve that first" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It conflicts with %1$@: resolve that first"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

    "Reads summaries of steps, sleep, heart rate, weight and more through your iPhone. Persona needs to be open on the phone with access granted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads summaries of steps, sleep, heart rate, weight and more through your iPhone. Persona needs to be open on the phone with access granted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneを通じて歩数、睡眠、心拍数、体重などの概要を読み取ります。iPhoneでPersonaを開き、アクセスを許可する必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经你的 iPhone 读取步数、睡眠、心率、体重等汇总，需要 Persona 在手机上打开并授权。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Reads the agent's last reply with the triage model, once per turn." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the agent's last reply with the triage model, once per turn."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターンごとに一度、トリアージモデルでエージェントの最後の返信を読みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每轮用分诊模型读一次 Agent 最后的回复。"
          }
        }
      }
    },
    "Reads this computer's ~/.zshrc, finds lines like alias x=\\\"K=V … claude\\\", and turns them into providers by gateway and key. Keys only pass through the hub and are stored encrypted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads this computer's ~/.zshrc, finds lines like alias x=\\\"K=V … claude\\\", and turns them into providers by gateway and key. Keys only pass through the hub and are stored encrypted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピューターの~/.zshrcを読み、alias x=\\\"K=V … claude\\\"の形の行を探して、ゲートウェイとKeyごとにプロバイダーにまとめます。Keyはハブを経由するだけで、暗号化して保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读这台电脑的 ~/.zshrc，找出形如 alias x=\"K=V … claude\" 的行，按网关和 Key 合成供应商。Key 只在 hub 里转手，加密保存。"
          }
        }
      },
      "extractionState" : "manual"
    },

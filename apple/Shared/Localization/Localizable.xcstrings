      }
    },
    "The connection dropped before the send was confirmed. Retrying checks existing messages first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped before the send was confirmed. Retrying checks existing messages first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切れたため、送信結果を確認できていません。再試行の前に既存のメッセージを確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接中断，尚未确认发送结果。重试前会先检查已有消息。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "The connection to this computer dropped. Reconnect it and check whether your last action went through before retrying." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection to this computer dropped. Reconnect it and check whether your last action went through before retrying."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和这台电脑的连接断了。请重新连接，确认刚才的操作是否已生效，然后再试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピューターとの接続が切れました。再接続して、直前の操作が反映されたか確認してから再試行してください。"
          }
        }
      }
    },
    "The connector is off, signed out or offline. Turn it on or sign in, then try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connector is off, signed out or offline. Turn it on or sign in, then try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コネクタがオフ、未サインイン、またはオフラインです。オンにするかサインインしてから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接器已关闭、未登录或离线。请打开或登录后再试。"
          }
        }
      }
    },
    "The credentials and sign-in saved on the hub will be deleted, and you'll need to sign in again to use it. Access granted in the other service isn't revoked automatically; revoke it there if needed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The credentials and sign-in saved on the hub will be deleted, and you'll need to sign in again to use it. Access granted in the other service isn't revoked automatically; revoke it there if needed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブに保存された認証情報とログイン状態は削除され、再度使うにはログインし直す必要があります。相手のサービス側の認可は自動では取り消されないため、必要に応じてそちらで取り消してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub 上存的凭据和登录状态会删掉，再用要重新登录。对方服务里的授权不会自动撤销，需要的话到那边撤销。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "The current branch goes to its upstream branch. Never forced: if the remote has newer commits, the push stops and says so." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current branch goes to its upstream branch. Never forced: if the remote has newer commits, the push stops and says so."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のブランチをアップストリームブランチにプッシュします。強制プッシュはしません。リモートに新しいコミットがあれば止めて知らせます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前分支会推到它的上游分支。不会强制推送：远端有更新的提交时会停下并说明。"
          }
        }
      }
    },
    "The current branch in “%@” goes to its upstream branch. Never forced: if the remote has newer commits, the push stops and says so." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current branch in “%@” goes to its upstream branch. Never forced: if the remote has newer commits, the push stops and says so."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の現在のブランチをアップストリームブランチにプッシュします。強制プッシュはしません。リモートに新しいコミットがあれば止めて知らせます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的当前分支会推到它的上游分支。不会强制推送：远端有更新的提交时会停下并说明。"
          }
        }
      }
    },
    "The current main chat will be archived as “%@” and you can find it under Archived. The new main chat starts with your next message." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current main chat will be archived as “%1$@” and you can find it under Archived. The new main chat starts with your next message."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のメインチャットは「%1$@」という名前でアーカイブされ、「アーカイブ済み」で確認できます。新しいメインチャットは次に送るメッセージから始まります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在的主对话会归档，改名为「%1$@」，之后在「已归档」里能找到。新的主对话从你发的下一条消息开始。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "The day was too long to read in full, so part of it isn't in the recap." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day was too long to read in full, so part of it isn't in the recap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一天太长，没能全部读完，当日回顾里少了一部分。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日が長すぎて全体を読み切れなかったため、一部がまとめに含まれていません。"
          }
        }
      }
    },
    "The day's audio and text are deleted from this iPhone and your Apple Watch now. Its text in Knowledge is removed after sync succeeds." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The day's audio and text are deleted from this iPhone and your Apple Watch now. Its text in Knowledge is removed after sync succeeds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这一天的音频和文字会马上从这台 iPhone 和你的 Apple Watch 上删除。知识库里的文字会在同步成功后移除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日の音声とテキストは、このiPhoneとApple Watchからすぐに削除されます。ナレッジのテキストは同期が完了すると削除されます。"
          }
        }
      }
    },
    "The default assistant can't be deleted. Make another one the default first" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The default assistant can't be deleted. Make another one the default first"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのアシスタントは削除できません。先に別のアシスタントをデフォルトにしてください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认助手不能删除，先把别的设为默认"
          }
        }
      }
    },
    "The delivery confirmation wasn't saved; the audio stays on the watch" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The delivery confirmation wasn't saved; the audio stays on the watch"

          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したプロトコルに対応するアドレスを入力してください。ハブは参照だけを保存し、キーが必要になったときに提供元から取得します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

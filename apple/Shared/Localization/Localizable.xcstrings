    "%@ is not on the remote yet: it is created on origin under the same name and tracked from now on. Never forced: if the remote has newer commits, the push stops and says so." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is not on the remote yet: it is created on origin under the same name and tracked from now on. Never forced: if the remote has newer commits, the push stops and says so."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はまだリモートにありません。origin に同名で作成し、以後追跡します。強制プッシュはしません。リモートに新しいコミットがあれば止めて知らせます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远端还没有 %1$@：会在 origin 上建同名分支，之后跟踪它。不会强制推送：远端有更新的提交时会停下并说明。"
          }
        }
      }
    },

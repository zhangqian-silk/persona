    "What was said in the last 10 minutes is deleted from this iPhone and your Apple Watch now, and from Knowledge after sync succeeds." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What was said in the last 10 minutes is deleted from this iPhone and your Apple Watch now, and from Knowledge after sync succeeds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 10 分钟说的话会马上从这台 iPhone 和你的 Apple Watch 上删除，同步成功后也会从知识库删除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近10分間の内容は、このiPhoneとApple Watchからすぐに削除され、同期が完了するとナレッジからも削除されます。"
          }
        }
      }
    },
    "What was said in the last 10 minutes is deleted from this watch now, and from your iPhone and Knowledge after sync." : {

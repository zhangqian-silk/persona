    "Audio stays on this device. Its text syncs to Knowledge and is kept for %lld days." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on this device. Its text syncs to Knowledge and is kept for %lld days."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこのデバイスに残り、テキストはナレッジに同期されて %lld 日間保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频保留在本机，文字会同步到知识库，并保留 %lld 天。"
          }
        }
      }
    },
    "Audio stays on this device; watch recordings come back here. After on-device transcription the text syncs to Knowledge automatically and is kept for the last %lld days, so the Assistant and agents can find it with a Knowledge search." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Audio stays on this device; watch recordings come back here. After on-device transcription the text syncs to Knowledge automatically and is kept for the last %1$lld day, so the Assistant and agents can find it with a Knowledge search."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Audio stays on this device; watch recordings come back here. After on-device transcription the text syncs to Knowledge automatically and is kept for the last %1$lld days, so the Assistant and agents can find it with a Knowledge search."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこのデバイスにのみ残り、Apple Watchの録音はここに戻ります。デバイス上で文字起こしした後、文字は自動でナレッジに同期され、直近%1$lld日分が保存されます。アシスタントとエージェントはナレッジ検索で見つけられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频只留在本机，手表录音会回传这里。本机转写后文字自动同步到知识库，保留最近 %1$lld 天，助手和 Agent 用知识库搜索就能找到。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Audio stays on this iPhone until 3 days after the day's final recap, 7 days at most. Only the text goes to Knowledge, where it's kept for %lld days; the recap is kept like meeting minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on this iPhone until 3 days after the day's final recap, 7 days at most. Only the text goes to Knowledge, where it's kept for %lld days; the recap is kept like meeting minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频只留在这台 iPhone 上，当日最终回顾生成 3 天后删除，最多保留 7 天。只有文字会进入知识库，保留 %lld 天；当日回顾像会议纪要一样保留。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこのiPhoneにだけ保存され、その日の最終的なまとめができてから3日後（最長7日）に削除されます。ナレッジに送られるのはテキストだけで、%lld日間保存されます。1日のまとめは議事録と同じように保存されます。"
          }
        }
      }
    },
    "Audio stays on this iPhone, except while you hold Talk: what is said then goes to the voice service." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on this iPhone, except while you hold Talk: what is said then goes to the voice service."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频保留在这台 iPhone 上，只有按住“说话”时例外：那时说的内容会发送到语音服务。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこの iPhone に残ります。ただし「話す」を押している間は例外で、そのときに話された内容は音声サービスに送られます。"
          }
        }
      }
    },
    "Audio stays on this iPhone, except while you hold Talk: what is said then goes to the voice service. Its text syncs to Knowledge and is kept for %lld days." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on this iPhone, except while you hold Talk: what is said then goes to the voice service. Its text syncs to Knowledge and is kept for %1$lld days."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频保留在这台 iPhone 上，只有按住“说话”时例外：那时说的内容会发送到语音服务。文字会同步到知识库，并保留 %1$lld 天。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声はこの iPhone に残ります。ただし「話す」を押している間は例外で、そのときに話された内容は音声サービスに送られます。テキストはナレッジに同期されて %1$lld 日間保存されます。"
          }
        }
      }
    },
    "Audio stays on this iPhone; the transcript goes to Knowledge. [Home Widgets]" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio stays on this iPhone; the transcript goes to Knowledge."

    "A draft pull request from %@ into %@ is opened on GitHub; everyone who can see the repository sees it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A draft pull request from %1$@ into %2$@ is opened on GitHub; everyone who can see the repository sees it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub に %1$@ から %2$@ への下書きプルリクエストを作成します。リポジトリを見られる人は全員見られます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会在 GitHub 上创建从 %1$@ 合进 %2$@ 的草稿拉取请求，能看到这个仓库的人都看得到。"
          }
        }
      }
    },
    "A draft pull request from %@ into the default branch is opened on GitHub; everyone who can see the repository sees it." : {

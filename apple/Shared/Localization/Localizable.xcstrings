    "Adds Messages to the sidebar to browse all direct and group chats. It shares accounts and chat history with the Inbox." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds Messages to the sidebar to browse all direct and group chats. It shares accounts and chat history with the Inbox."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーに「メッセージ」を追加し、すべての個人チャットとグループチャットを表示します。アカウントとチャット履歴は受信トレイと共有します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在侧边栏增加「消息」，查看全部私聊和群聊。与收件箱共用账号和聊天记录。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Adds a Messages entry on Home to browse all direct and group chats. It shares accounts and chat history with the Inbox." : {

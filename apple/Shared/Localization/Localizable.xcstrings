    "Revoking stops the current response to clear its permissions. Send another message to continue." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoking stops the current response to clear its permissions. Send another message to continue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消すと、現在の応答を停止して権限を消去します。次のメッセージを送ると続行できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撤销会停止当前回复，以清除运行中的权限。发送下一条消息即可继续。"
          }

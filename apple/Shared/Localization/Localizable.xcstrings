    "This meeting's audio also went through your hub to its speech service; the hub deletes it once the minutes are written. After the retention period (%lld days) the recording is cleared from this device and Knowledge." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This meeting's audio also went through your hub to its speech service; the hub deletes it once the minutes are written. After the retention period (%1$lld days) the recording is cleared from this device and Knowledge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这场会议的音频还经你的 hub 发送到了它的语音服务；会议纪要写好后，hub 会删除这段音频。过了保留期（%1$lld 天）本机和知识库里都会清掉这段录音。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会議の音声はハブを経由して音声サービスにも送られました。議事録ができるとハブはその音声を削除します。保存期間（%1$lld日）を過ぎると、このデバイスとナレッジの両方から消去されます。"
          }
        }
      }
    },
    "This meeting's audio, Talk included, goes through your hub to %@, and the hub deletes it once the minutes are written." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This meeting's audio, Talk included, goes through your hub to %1$@, and the hub deletes it once the minutes are written."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这场会议的音频（包括“说话”）会经你的 hub 发送到 %1$@，会议纪要写好后 hub 就删除它。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会議の音声は（「話す」を含め）ハブを経由して %1$@ に送られ、議事録ができるとハブが削除します。"
          }
        }
      }
    },

    "Persona Link runs outside the desktop session on this computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona Link runs outside the desktop session on this computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピュータの Persona Link はデスクトップセッションの外で動いています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑上的 Persona Link 运行在桌面会话之外。"
          }
        }
      }
    },
    "Persona Link tells the hub you're at this computer while it's unlocked and in use. This stops when you lock the computer or quit Persona Link." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona Link tells the hub you're at this computer while it's unlocked and in use. This stops when you lock the computer or quit Persona Link."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑解锁且你在用时，Persona Link 会告诉 hub 你在电脑前。锁定电脑或退出 Persona Link 后停止。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコンピューターのロックが解除され使用中の間、Persona Link はあなたがこのコンピューターの前にいることを hub に伝えます。コンピューターをロックするか Persona Link を終了すると止まります。"
          }
        }
      }
    },

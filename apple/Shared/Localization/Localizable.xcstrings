    "What's noted in health chats is read only by health chats; Persona's other chats can't see it. Fix anything wrong right here, or tell it in a health chat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What's noted in health chats is read only by health chats; Persona's other chats can't see it. Fix anything wrong right here, or tell it in a health chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアのチャットで記録した内容はヘルスケアのチャットだけが読み、Personaの他のチャットからは見えません。誤りはここで直接修正するか、ヘルスケアのチャットで伝えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康对话里记下的事，只有健康对话会读，Persona 的其他对话看不到。说错的地方可以直接改，或者在健康对话里告诉它。"
          }
        }
      },
      "extractionState" : "manual"
    },

        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの場所でコピーして Persona に戻ったとき、クリップボードを共有しているコンピュータへ送るよう提案します。クリップボードは「送信」をタップしたときだけ読み取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

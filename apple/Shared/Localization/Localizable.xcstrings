          }
        }
      }
    },
    "These settings take their values from this provider. Saving a setting lets it keep taking its value." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These settings take their values from this provider. Saving a setting lets it keep taking its value."
          }

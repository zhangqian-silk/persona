    "Monitoring history is kept for 24 hours: one point every 10 seconds for the last hour, one a minute before that. Gaps while disconnected aren't joined." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitoring history is kept for 24 hours: one point every 10 seconds for the last hour, one a minute before that. Gaps while disconnected aren't joined."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モニタリング履歴は24時間保持されます。直近1時間は10秒ごと、それ以前は1分ごとに記録し、切断中の区間は線でつなぎません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "监控历史保留 24 小时。最近 1 小时每 10 秒一个点，更早的每分钟一个点；中间断开的时段不连线。"
          }
        }
      },
      "extractionState" : "manual"
    },

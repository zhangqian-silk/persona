    "Option types special characters as usual (Option+2 is ™). When this is on, Option+key sends Esc+key, like the setting of the same name in the Terminal app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option types special characters as usual (Option+2 is ™). When this is on, Option+key sends Esc+key, like the setting of the same name in the Terminal app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionで通常どおり特殊文字を入力します（Option+2は™）。オンにするとOption+キーでEsc+キーを送信します。「ターミナル」Appの同名の設定と同じです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option 照常打出特殊字符（Option+2 是 ™）；打开后 Option+键 发出 Esc+键，和「终端」App 的同名设置一样。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Option+letter sends Esc+letter, so Option+B / Option+F move by word in the shell; Option no longer types special characters like ™ or é. Input methods work as usual." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option+letter sends Esc+letter, so Option+B / Option+F move by word in the shell; Option no longer types special characters like ™ or é. Input methods work as usual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option+文字でEsc+文字を送信し、shellではOption+B / Option+Fで単語単位に移動します。Optionで™やéなどの特殊文字は入力できなくなります。入力方式は通常どおり使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option+字母发出 Esc+字母，shell 里 Option+B / Option+F 按词移动；Option 打不出 ™、é 这类特殊字符了。输入法照常用。"
          }
        }
      },
      "extractionState" : "manual"
    },

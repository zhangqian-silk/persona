    "\"%@\" is %@ long and still over 200 MB at 540p, so it can't be sent. Trim it in Photos first." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」有 %2$@，压缩到 540p 也超过 200 MB，发不了：先在「照片」里剪短再发"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" is %2$@ long and still over 200 MB at 540p, so it can't be sent. Trim it in Photos first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は%2$@あり、540pに圧縮しても200MBを超えるため送信できません。先に「写真」でトリミングしてください"
          }
        }
      },
      "extractionState" : "manual"
    },

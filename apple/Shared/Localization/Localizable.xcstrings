          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %1$@ 说："
          }
        }
      }
    },
    "You can also just tell Persona “Add a mail account for me”, give it the address and password, and confirm in the app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also just tell Persona “Add a mail account for me”, give it the address and password, and confirm in the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaに「メールアカウントを追加して」と伝えて、アドレスとパスワードを教え、Appで確認するだけでも追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以直接在 Persona 里说「帮我添加邮箱」，把邮箱和密码告诉它，在 App 里确认后就加好了。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "You can also just tell Persona “Add a mail account for me”, give it the address and password, and confirm on your phone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also just tell Persona “Add a mail account for me”, give it the address and password, and confirm on your phone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaに「メールアカウントを追加して」と伝えて、アドレスとパスワードを教え、スマートフォンで確認するだけでも追加できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也可以直接在 Persona 里说「帮我添加邮箱」，把邮箱和密码告诉它，在手机上确认后就加好了。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "You can change the permission mode and thinking effort anytime in the chat." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change the permission mode and thinking effort anytime in the chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限モードと思考の強さはチャット内でいつでも変更できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "权限模式和思考强度在对话里也能随时改。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "You can choose up to 4 attachments at a time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can choose up to 4 attachments at a time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度に選択できる添付ファイルは4個までです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次最多选择 4 个附件"
          }
        }
      },
      "extractionState" : "manual"
    },
    "You can come back here from the top of Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can come back here from the top of Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで「設定」の一番上からここに戻れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后可以在「设置」顶部回到这里。"
          }
        }

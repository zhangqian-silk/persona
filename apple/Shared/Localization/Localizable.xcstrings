    "Only the text and timestamps go into Knowledge; the original audio isn't uploaded. After the retention period (%lld days) it's cleared from this device and Knowledge." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Only the text and timestamps go into Knowledge; the original audio isn't uploaded. After the retention period (%1$lld day) it's cleared from this device and Knowledge."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Only the text and timestamps go into Knowledge; the original audio isn't uploaded. After the retention period (%1$lld days) it's cleared from this device and Knowledge."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナレッジに入るのは文字とタイムスタンプだけで、元の音声はアップロードされません。保存期間（%1$lld日）を過ぎると、このデバイスとナレッジの両方から消去されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有文字和时间戳进知识库，原始音频不上传；过了保留期（%1$lld 天）本机和知识库里都会清掉。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Only this device can open this address. To sign in on another device, connect through the hub's address first, then generate a code." : {

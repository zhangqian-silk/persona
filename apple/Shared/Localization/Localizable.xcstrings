    "This proxy isn't on this device: Persona's traffic to the hub, this device's credential and the proxy's password would cross the network unencrypted." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This proxy isn't on this device: Persona's traffic to the hub, this device's credential and the proxy's password would cross the network unencrypted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロキシはこのデバイス上にありません。Personaからハブへの通信、このデバイスの認証情報、プロキシのパスワードが暗号化されずにネットワークを流れます。"
          }
        },
        "zh-Hans" : {

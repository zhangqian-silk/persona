        }
      }
    },
    "Only messages from the bound person go to Persona. Others get a short explanation, and group chats are ignored." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only messages from the bound person go to Persona. Others get a short explanation, and group chats are ignored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紐づけた本人がボットに送ったメッセージだけがPersonaに渡されます。ほかの人には説明を1文返すだけで、グループでは何もしません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有绑定的这个人发给机器人的消息会交给 Persona；别人发来只回一句说明，群里一律不处理。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Only on this screen, never said aloud" : {
      "extractionState" : "manual",
      "localizations" : {

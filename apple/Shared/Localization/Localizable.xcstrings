    },
    "The hub stops reading this market. %lld extensions installed from it stay, but stop upgrading until the market is added again with the same address." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The hub stops reading this market. %1$lld extension installed from it stays, but stops upgrading until the market is added again with the same address."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The hub stops reading this market. %1$lld extensions installed from it stay, but stop upgrading until the market is added again with the same address."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブはこのマーケットを読まなくなります。そこからインストールした%1$lld件の拡張機能は残りますが、同じアドレスでマーケットを追加し直すまでアップグレードされません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub 不再读这个市场。从它装的 %1$lld 个扩展留着，但不再升级，直到用同样的地址把市场加回来。"
          }
        }
      }
    },

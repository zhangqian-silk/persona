        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ペアリング済み」と表示されれば完了です。この画面は自動で次に進みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看到「已配对」就好了，这一屏会自己往下走。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Once it's connected this updates by itself, no need to refresh." : {
      "localizations" : {
        "en" : {

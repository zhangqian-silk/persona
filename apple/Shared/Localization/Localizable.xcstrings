    "Installing elsewhere gives you a new install code. Once it's installed with that code, the assistant where it ran before stops working right away." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing elsewhere gives you a new install code. Once it's installed with that code, the assistant where it ran before stops working right away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の場所にインストールすると新しいインストールコードが発行されます。そのコードでインストールすると、以前の場所のアシスタントはすぐに動作を停止します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换个地方装会给一个新的安装码；用它装好后，原来那处的助手立即停止工作。"
          }
        }
      }
    },

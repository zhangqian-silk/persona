        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いた後に、Agent や別のアプリで変更されたようです。いま保存するとその変更が上書きされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

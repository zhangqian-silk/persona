    "By default an idle Agent stops after 12 hours and keeps its terminal, and a closed session with no open task moves to Archived after 3 idle days." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default an idle Agent stops after 12 hours and keeps its terminal, and a closed session with no open task moves to Archived after 3 idle days."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定では、12 時間アイドル状態のエージェントは停止し、ターミナルは残ります。閉じていて未完了のタスクがないセッションは、3 日間アイドルが続くと「アーカイブ済み」に移ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认闲置 12 小时的 Agent 会停止，终端保留；已关闭、身上没有未完成任务的会话闲置 3 天后移到「已归档」。"
          }
        }
      }
    },

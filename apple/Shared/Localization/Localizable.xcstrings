    "Add the weather widget to the home screen [Layout sample]" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the weather widget to the home screen"
          }
        },

    "ctrl is always there; the keyboard button and arrows are at the far right. When the keys don't fit, swipe the key bar sideways." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ctrl is always there; the keyboard button and arrows are at the far right. When the keys don't fit, swipe the key bar sideways."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ctrlは常に表示され、キーボードボタンと矢印キーは右端にあります。収まらないときはキーバーを左右にスワイプできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ctrl 一直在，键盘按钮和方向键在最右。放不下时键栏可以左右滑。"
          }
        }
      },
      "extractionState" : "manual"
    },

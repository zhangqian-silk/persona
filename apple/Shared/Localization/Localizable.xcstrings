    "These extensions depend on it and will be turned off too: %@. They're only turned off, not uninstalled; their settings and data stay." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These extensions depend on it and will be turned off too: %1$@. They're only turned off, not uninstalled; their settings and data stay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の拡張機能はこれに依存しているため、一緒に無効になります：%1$@。無効にするだけでアンインストールはせず、設定とデータは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下扩展依赖它，将一起停用：%1$@。只停用，不卸载；设置和数据保留。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "These only appeared in notifications, marketing emails or bot chats and won't be updated. Set them back to Active under Tag to restore them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These only appeared in notifications, marketing emails or bot chats and won't be updated. Set them back to Active under Tag to restore them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知、宣伝メール、ボットの会話にしか出てこなかったもので、今後は更新されません。タグ付けで「進行中」に戻すと元に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在通知、营销邮件、机器人会话里出现的，不会再更新。打标里改回「进行中」就恢复。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "These saved permissions apply only to this conversation. Records store the tool name, but not detailed directory or command scope." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These saved permissions apply only to this conversation. Records store the tool name, but not detailed directory or command scope."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された権限は、この会話だけに適用されます。記録にはツール名のみが保存され、ディレクトリやコマンドの詳細な範囲はありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些已保存的权限仅适用于这段对话。记录只保留工具名，没有目录或命令的详细范围。"
          }
        }
      }
    },
    "These settings belong to the default assistant “%@”." : {
      "comment" : "Settings › Model Settings while another assistant than the default is current",

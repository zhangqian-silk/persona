    "Copies a computer's clipboard (text or an image) to this phone and returns the text. The computer needs clipboard sharing turned on in Persona." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies a computer's clipboard (text or an image) to this phone and returns the text. The computer needs clipboard sharing turned on in Persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータのクリップボード（テキストまたは画像）をこのスマートフォンにコピーし、テキストを返します。Persona でそのコンピュータのクリップボード共有をオンにしておく必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把电脑剪贴板里的文字或图片复制到手机，并返回其中的文字。需要先在 Persona 里给这台电脑打开剪贴板共享。"
          }
        }
      }

    },
    "Scan the QR code shown when the hub was set up, or the one from Settings › Devices › Connect a new device on a connected device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the QR code shown when the hub was set up, or the one from Settings › Devices › Connect a new device on a connected device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hub のセットアップ時に表示された QR コード、または接続済みのデバイスの「設定 › デバイス › 新しいデバイスを接続」のコードを読み取ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫 hub 装好时屏幕上的二维码，或者已经连上的设备里 设置 › 设备 › 连接新设备 出的码。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Scan this code on the new device's Persona pairing screen. On a Mac or Android you can also copy the pairing link and paste it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan this code on the new device's Persona pairing screen. On a Mac or Android you can also copy the pairing link and paste it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいデバイスのPersonaのペアリング画面でこのコードをスキャンしてください。MacとAndroidではペアリングリンクをコピーして貼り付けることもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新设备的 Persona 配对页扫这个码。Mac 和 Android 也可以拷贝配对链接后粘贴。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Scan to connect a hub" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan to connect a hub"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR コードで hub に接続"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫码连接 hub"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Scan with %@; whoever scans becomes this channel's owner. The sign-in is stored encrypted on the hub and deleted when you unbind." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan with %1$@; whoever scans becomes this channel's owner. The sign-in is stored encrypted on the hub and deleted when you unbind."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でスキャンします。スキャンした人がこのチャネルの所有者になります。ログイン状態は暗号化してハブに保存され、紐づけ解除時に削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用%1$@扫码，扫码的人就是这个渠道的主人；登录状态加密存在 hub 上，解除绑定时删掉。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Scan with a phone camera to open it in the browser, or copy the sign-in link to a browser on another computer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan with a phone camera to open it in the browser, or copy the sign-in link to a browser on another computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンのカメラでスキャンするとブラウザで直接開きます。またはログインリンクを別のコンピューターのブラウザにコピーしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手机相机扫码直接在浏览器里打开，或把登录链接拷到另一台电脑的浏览器。"
          }
        }
      },
      "extractionState" : "manual"
    },

          "stringUnit" : {
            "state" : "translated",
            "value" : "If it isn't signed in or doesn't work, you can pick a provider and paste its API key."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインしていない、または使えない場合は、プロバイダーを選んで API キーを貼り付けることもできます。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "If it waits: %@" : {

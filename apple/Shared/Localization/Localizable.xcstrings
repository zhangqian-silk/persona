    "Sends a real one-word request (a few tokens) to see whether it answers, how long it takes, and which model replies." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends a real one-word request (a few tokens) to see whether it answers, how long it takes, and which model replies."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1語だけで答える実際のリクエストを送り（数トークン消費）、応答できるか、かかる時間、応答したモデルを確認します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "真的发一个只回答一个词的请求（花几个 token），看能不能回答、要多久、是哪个模型答的。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Sends a task to a personal agent session (the Lark gateway's agent-bridge) to carry out. With no session chosen, it goes to the most recently active one that can receive messages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends a task to a personal agent session (the Lark gateway's agent-bridge) to carry out. With no session chosen, it goes to the most recently active one that can receive messages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクを個人エージェントのセッション（Larkゲートウェイのagent-bridge）に送って実行させます。セッションを選ばない場合は、最近アクティブで送信可能なものに送ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把一件事发给某个个人 Agent 会话（飞书网关的 agent-bridge），由它去做。不选会话时发给最近活跃、能发送的那个。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Sends the queued messages to the agent now. A command it is running keeps running in the background; a reply it is writing starts again with your message. [Queue Strip]" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the queued messages to the agent now. A command it is running keeps running in the background; a reply it is writing starts again with your message."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちのメッセージを今すぐエージェントに送ります。実行中のコマンドはバックグラウンドで続き、書いている途中の返信はあなたのメッセージを含めてやり直します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在就把排队的消息发给 Agent。它正在跑的命令会转到后台继续跑；正在写的回复会带上你的消息重新开始。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Sends what you say to the Persona assistant's main chat, waits for the answer and reads it out. If it takes a while, you'll hear that it was sent and can read the answer in the app later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends what you say to the Persona assistant's main chat, waits for the answer and reads it out. If it takes a while, you'll hear that it was sent and can read the answer in the app later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaアシスタントのメインチャットに送り、回答を待って読み上げます。回答に時間がかかる場合は送信したことだけを伝え、あとでアプリで確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这句话发进 Persona 助手的主对话，等它回答并读出来；答得慢就先告诉你已发出，回头在 App 里看。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Sends what you say to the latest session on a machine, or starts a new one in herdr." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends what you say to the latest session on a machine, or starts a new one in herdr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの言葉をマシン上の最新のセッションに送るか、herdrで新しいセッションを開始します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把你这句话发给某台机器上最近的会话，或者在 herdr 里新开一个。"
          }
        }
      },
      "extractionState" : "manual"
    },

    },
    "Chats and people from %@ are deleted from Knowledge, and “Save to Knowledge” is turned off. The Inbox and the assistant's searches of %@ aren't affected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知识库里从 %1$@ 来的会话和人都会删掉，「进知识库」会关掉。收件箱和助手查 %2$@ 不受影响。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats and people from %1$@ are deleted from Knowledge, and “Save to Knowledge” is turned off. The Inbox and the assistant's searches of %2$@ aren't affected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ナレッジ内の%1$@から来たチャットと人物が削除され、「ナレッジに保存」がオフになります。受信トレイとアシスタントによる%2$@の検索には影響しません。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Chats and people from %@ in Knowledge and its Inbox items are deleted, and syncing is turned off. Project summaries leave them out the next time they update." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

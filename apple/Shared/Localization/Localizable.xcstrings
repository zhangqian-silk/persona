    "Turn Persona on in the menu to ask, or use Just Me." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn Persona on in the menu to ask, or use Just Me."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单里打开 Persona 再提问，或者用“仅自己”。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問するにはメニューで Persona をオンにするか、「自分だけ」を使ってください。"
          }
        }
      }
    },
    "Turn it on from “…” in the top-right corner. Move your finger to move the pointer, tap to click at the pointer, and tap then drag right away to drag. If the pointer drifts off, use “Center Pointer”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on from “…” in the top-right corner. Move your finger to move the pointer, tap to click at the pointer, and tap then drag right away to drag. If the pointer drifts off, use “Center Pointer”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の「…」からオンにします。指を動かすとポインタが動き、タップでポインタの位置をクリック、タップ直後にドラッグするとドラッグになります。ポインタがずれたら「ポインタを中央へ」を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从右上角「…」里打开。手指在屏幕上移动指针；轻点在指针处点击；轻点后马上拖动是拖拽。指针跑偏了用「指针居中」。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Turn it on on the computer's page too" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on on the computer's page too"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピューターのページでもオンにしてください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还要在电脑的机器页上打开"
          }
        }
      }
    },
    "Turn it on to bind it and receive messages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on to bind it and receive messages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると紐づけとメッセージの受信ができます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后才能绑定和收消息。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Turn it on to sign in. Once you're signed in, %@ will be added to Knowledge and the Inbox, and the Assistant can search them too." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn it on to sign in. Once you're signed in, %1$@ will be added to Knowledge and the Inbox, and the Assistant can search them too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにするとログインできます。ログイン後、%1$@がナレッジと受信トレイに入り、アシスタントも検索できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后才能登录，登录后%1$@进知识库和收件箱，助手也能查。"
          }
        }
      },
      "extractionState" : "manual"
    },

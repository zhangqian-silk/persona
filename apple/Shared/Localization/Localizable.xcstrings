          "stringUnit" : {
            "state" : "translated",
            "value" : "它已经不在了，或者不能从手机读取。"
          }
        }
      }
    },
    "It isn’t there anymore. Pull down to refresh." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It isn’t there anymore. Pull down to refresh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう存在しません。下に引いて更新してください。"

        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有完成"
          }
        }
      }
    },
    "It didn't start after the last update, so it went back to %@ and won't auto-update to this version" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It didn't start after the last update, so it went back to %1$@ and won't auto-update to this version"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のアップデート後に起動しなかったため%1$@に戻しました。このバージョンには自動アップデートしません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次升级后起不来，已回到 %1$@，不再自动升级到这个版本"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It goes to the computer’s Trash. You can undo right after, or put it back from the Trash there." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It goes to the computer’s Trash. You can undo right after, or put it back from the Trash there."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピューターのゴミ箱に移動します。直後なら取り消せます。あとでそのゴミ箱から戻すこともできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会移到那台电脑的废纸篓。可以马上撤销，也可以之后从那里的废纸篓放回。"
          }
        }
      }
    },
    "It installs as a background task that starts when you sign in, with no window and no administrator rights." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It installs as a background task that starts when you sign in, with no window and no administrator rights."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン時に自動で起動するバックグラウンドタスクとしてインストールされます。ウィンドウは開かず、管理者権限も不要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会装成登录时自动启动的后台任务，不弹窗口，也不用管理员权限。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "It is deleted from the hub and from your other devices. Where it is in use, the default avatar comes back." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is deleted from the hub and from your other devices. Where it is in use, the default avatar comes back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブとほかのデバイスから削除されます。使用中の場所ではデフォルトのアバターに戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会从 hub 和你的其他设备上删除。正在用它的地方会换回默认形象。"
          }
        }
      }
    },
    "It is taken back through %@ and removed for everyone who can see it. This can't be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is taken back through %@ and removed for everyone who can see it. This can't be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 経由で取り消され、表示できるすべての人から削除されます。元に戻せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将通过 %@ 撤回，所有能看到它的人都将看不到它，且无法恢复。"
          }
        }
      }
    },
    "It isn't installed yet. Rename it or make it the default once it is" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It isn't installed yet. Rename it or make it the default once it is"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだインストールされていません。インストール後に名前の変更やデフォルト設定ができます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它还没装好，装好后才能改名或设为默认"
          }
        }
      }
    },
    "It isn't known whether the message was removed. Try again to check." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It isn't known whether the message was removed. Try again to check."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージが削除されたかどうか分かりません。もう一度試して確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不确定消息是否已被删除。可以再试一次确认。"
          }
        }
      }
    },
    "It isn’t there anymore, or it can’t be read from your phone." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It isn’t there anymore, or it can’t be read from your phone."
          }

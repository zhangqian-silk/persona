    "Names and words the hub's transcription should spell right, such as people, products and projects: up to 200, each at most 40 characters. A meeting's title and its attendees are added by themselves." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names and words the hub's transcription should spell right, such as people, products and projects: up to 200, each at most 40 characters. A meeting's title and its attendees are added by themselves."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希望 hub 转写时写对的名字和词语，比如人名、产品和项目：最多 200 个，每个不超过 40 个字。会议标题和参会人会自动加上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブの文字起こしで正しく書いてほしい名前や語句（人名、製品、プロジェクトなど）。最大 200 件、各 40 文字まで。会議のタイトルと参加者は自動で加わります。"
          }
        }
      }
    },
    "Names are 1 to 40 characters" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names are 1 to 40 characters"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前は1〜40文字にしてください"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名字要 1 到 40 个字"
          }
        }
      }
    },
    "Names can only use letters, digits, _, and -, and must start with a letter or _" : {
      "localizations" : {

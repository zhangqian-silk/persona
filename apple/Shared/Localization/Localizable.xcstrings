          }
        }
      },
      "extractionState" : "manual"
    },
    "Install Persona Link on that computer first, then open a terminal, paste the line below and press Return." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Persona Link on that computer first, then open a terminal, paste the line below and press Return."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずそのコンピュータに Persona Link をインストールし、ターミナルを開いて下の 1 行を貼り付け、Return を押してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先在那台电脑上装好 Persona Link，再打开终端，粘贴下面这一行，回车。"
          }
        }
      },
      "extractionState" : "manual"
    },

    "In the background, Persona pulls durable knowledge out of your project timelines and chats and files it by topic. The map fills in as it does." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the background, Persona pulls durable knowledge out of your project timelines and chats and files it by topic. The map fills in as it does."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona 会在后台从项目时间线和会话里整理出以后用得上的知识，按主题归类，整理出来导图就会慢慢填满。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona はバックグラウンドで、プロジェクトのタイムラインと会話から後で役立つ知識を取り出し、トピックごとに整理します。整理が進むにつれてマップが埋まっていきます。"
          }
        }
      }
    },
    "No Projects Yet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Projects Yet"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有项目"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトはまだありません"
          }
        }
      }
    },
    "Projects appear as Persona sorts them out of your chats and Agents' work." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projects appear as Persona sorts them out of your chats and Agents' work."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona 从会话和 Agent 的工作里整理出项目后，就会显示在这里。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona が会話や Agent の作業からプロジェクトを整理すると、ここに表示されます。"
          }
        }
      }
    },
    "Knowledge Persona pulled out of project timelines and chats, filed by topic rather than by project: concepts, decisions, how-tos, pitfalls and facts. Select a topic or a point to see it here." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knowledge Persona pulled out of project timelines and chats, filed by topic rather than by project: concepts, decisions, how-tos, pitfalls and facts. Select a topic or a point to see it here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona 从项目时间线和会话里整理出的知识，按主题而不是按项目归类：概念、决定、做法、坑和事实。选一个主题或知识点，在这里查看。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persona がプロジェクトのタイムラインと会話から取り出した知識を、プロジェクトではなく主題ごとに整理したものです：概念、決定、やり方、落とし穴、事実。トピックかポイントを選ぶとここに表示されます。"
          }
        }
      }
    },
    "Each project's goal, status and the main chat's notes, with its curated summary by section. Select a project to see it here." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each project's goal, status and the main chat's notes, with its curated summary by section. Select a project to see it here."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个项目的目标、状态和主对话的记录，以及后台整理的分节摘要。选一个项目，在这里查看。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロジェクトの目標、状態、メインチャットの記録と、セクションごとの概要です。プロジェクトを選ぶとここに表示されます。"

    "Check “Start These Directly” on a plan card in a chat, and tasks on the same computer and folder with the same read or edit access won't ask first again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check “Start these directly from now on” on a plan card in a chat, and tasks on the same computer and folder with the same read or edit access won't ask first again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャットのプランカードで「今後はすぐに開始」にチェックを入れると、同じコンピューター・同じフォルダで同じ読み取り／編集権限のタスクは、次から確認なしで開始します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在对话的计划卡上勾「这类以后直接开」，同一台电脑、同一个目录、同样读或改的任务以后就不再先问。"
          }
        }
      }
    },

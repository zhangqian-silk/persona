    "Write down something to do, hand it to an agent, and track its progress." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down something to do, hand it to an agent, and track its progress."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やることを書き留めて、エージェントに任せ、進捗を追跡できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

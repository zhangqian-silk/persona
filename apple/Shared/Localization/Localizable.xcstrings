      "extractionState" : "manual"
    },
    "The machine is offline; your choice takes effect once it connects. The desktop apps' sessions are shown, and starting or continuing a session from your phone is off." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

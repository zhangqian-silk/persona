      "extractionState" : "manual"
    },
    "Tap to click there. Drag with one finger to drag. Drag with two fingers to scroll. Two-finger tap or touch and hold to right-click." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

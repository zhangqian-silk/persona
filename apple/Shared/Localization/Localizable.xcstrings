    "Updates wait until the assistant and all agents are idle before restarting the hub; if the new version doesn't start, it rolls back automatically. Connections drop briefly during the restart." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates wait until the assistant and all agents are idle before restarting the hub; if the new version doesn't start, it rolls back automatically. Connections drop briefly during the restart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートは、アシスタントとすべてのエージェントがアイドルになってからハブを再起動します。新しいバージョンが起動しない場合は自動で前のバージョンに戻ります。再起動中は接続が一時的に切れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新会等助手和所有 Agent 都空闲时再重启 hub；新版本起不来会自动回到上一版。重启期间连接会断开一会儿。"
          }
        }
      },
      "extractionState" : "manual"
    },

        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回传确认没有保存，音频仍保留在手表"
          }
        }
      },
      "extractionState" : "manual"
    },
    "The dialog in the terminal changed, so no keys were pressed. Check the new one and answer again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dialog in the terminal changed, so no keys were pressed. Check the new one and answer again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルのダイアログが変わったため、キーは送信していません。新しい内容を確認してから回答してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端上的对话框已经变了，这次没有按任何键：看看新的再答"
          }
        }
      },
      "extractionState" : "manual"
    },
    "The document is stored whatever the rules say. Leave the days empty to add no deletion date." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document is stored whatever the rules say. Leave the days empty to add no deletion date."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールにかかわらずこのドキュメントを保存します。日数を空欄にすると削除期限は設定されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不管规则怎么设都保存这篇文档。天数留空则不设删除期限。"
          }
        }
      }
    },
    "The earlier choice “%@” stays, struck through; only the new one goes to agents." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The earlier choice “%1$@” stays, struck through; only the new one goes to agents."
          }
        },
        "ja" : {

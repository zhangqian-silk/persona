    "Install Persona Link on that Mac. There is no installer yet: you build it from source." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Persona Link on that Mac. There is no installer yet: you build it from source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その Mac に Persona Link をインストールしてください。まだインストーラはなく、ソースからビルドする必要があります。"
          }

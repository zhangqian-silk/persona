    "Set last, over the fields above and the computer's own. NAME= with nothing after it sets a variable empty; to go around a proxy, choose No Proxy under Proxy instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set last, over the fields above and the computer's own. NAME= with nothing after it sets a variable empty; to go around a proxy, choose No Proxy under Proxy instead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に設定され、上の項目やコンピューター側の設定より優先されます。NAME= のように値を空にすると、その変数が空になります。プロキシを通さないようにするには、代わりに「プロキシ」で「プロキシを使わない」を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最后设置，优先于上面各项和这台电脑自己的设置；写 NAME= 不带值会把变量设成空。要让这个网关不走代理，请改在「代理」里选「不使用代理」。"
          }
        }
      }
    },
    "Set or clear a goal in the agent; in Claude Code, send /goal <condition> or /goal clear in the message field." : {

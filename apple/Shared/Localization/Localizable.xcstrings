    "Hands a notification, or anything else you pass in, to Persona as an item of this device's Shortcuts source in Settings › Subscriptions. Only what you pass in is sent: nothing reads other apps' notifications." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands a notification, or anything else you pass in, to Persona as an item of this device's Shortcuts source in Settings › Subscriptions. Only what you pass in is sent: nothing reads other apps' notifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知や渡したほかの内容を、「設定 › 購読」にあるこのデバイスのショートカットソースの項目として Persona に渡します。渡した内容だけを送り、ほかのアプリの通知は読み取りません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把通知或你传进来的其他内容交给 Persona，作为这台设备在「设置 › 订阅」里的快捷指令来源的一条。只发送你传进来的内容，不会读取其他 App 的通知。"
          }
        }
      }
    },

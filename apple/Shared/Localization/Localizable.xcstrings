            "value" : "トラックパッドで3本指の左右スワイプ：同じスペースのエージェントを切り替え（システム設定 › トラックパッドで「ページ間をスワイプ」を3本指にしている場合）"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触控板三指左右轻扫：切换同一空间里的 Agent（系统设置 › 触控板里「在页面之间轻扫」选三指时）"
          }
        }

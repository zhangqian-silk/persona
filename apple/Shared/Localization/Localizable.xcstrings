          }
        }
      },
      "extractionState" : "manual"
    },
    "The machine is offline; your choice takes effect once it connects. Only sessions in the selected engine are shown." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The machine is offline; your choice takes effect once it connects. Only sessions in the selected engine are shown."
          }
        },
        "ja" : {

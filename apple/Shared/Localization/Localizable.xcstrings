          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在推送"
          }
        }
      }
    },
    "Put skills in ~/.persona/skills/ on the computer that runs the assistant, one directory each (with a SKILL.md inside)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put skills in ~/.persona/skills/ on the computer that runs the assistant, one directory each (with a SKILL.md inside)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントを動かしているコンピューターの~/.persona/skills/にスキルを置きます。1つにつき1ディレクトリ（中にSKILL.md）です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 skill 放进跑助手的那台电脑的 ~/.persona/skills/，每个一个目录（里面有 SKILL.md）。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Puts this phone's clipboard, or the text you pass in, on a computer's clipboard. The computer needs clipboard sharing turned on in Persona." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puts this phone's clipboard, or the text you pass in, on a computer's clipboard. The computer needs clipboard sharing turned on in Persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンのクリップボード（または渡したテキスト）をコンピュータのクリップボードに入れます。Persona でそのコンピュータのクリップボード共有をオンにしておく必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把手机的剪贴板（或传入的文字）放到电脑的剪贴板上。需要先在 Persona 里给这台电脑打开剪贴板共享。"
          }
        }
      }
    },

      "extractionState" : "manual"
    },
    "You can pause at any time, erase the last 10 minutes, or delete a whole day." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can pause at any time, erase the last 10 minutes, or delete a whole day."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你随时可以暂停、删掉最近 10 分钟，或删除一整天的录音。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつでも一時停止したり、直近10分や1日分の録音を削除したりできます。"
          }
        }
      }
    },
    "You can search chat names and recent messages. Try another word." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can search chat names and recent messages. Try another word."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット名と最近のメッセージを検索できます。別の言葉で試してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话的名称和最近消息都能搜，换个词试试。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "You can search space, tab and session titles and content. Try another word." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the same thing as another project, so its timeline, chats and people were moved there. This shows how it looked before the merge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のプロジェクトと同じ内容のため、タイムライン、会話、人はそちらに統合されました。ここには統合前の状態が残っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和另一个项目是同一件事，时间线、会话和人都并过去了。这里保留合并前的样子。"
          }

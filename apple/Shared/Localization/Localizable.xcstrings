          }
        }
      }
    },
    "This won't wait for them to finish: anything waiting on the hub is interrupted (the assistant's current turn, uploads in progress, terminal connections). Agents in herdr aren't affected and reconnect once the hub is back." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This won't wait for them to finish: anything waiting on the hub is interrupted (the assistant's current turn, uploads in progress, terminal connections). Agents in herdr aren't affected and reconnect once the hub is back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了を待たずに更新します。ハブを待っている操作（アシスタントの現在のターン、アップロード中のファイル、ターミナル接続）は中断されます。herdrのエージェントには影響せず、ハブの起動後に自動で再接続します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不再等它们结束：会中断正在等 hub 的操作（助手这一轮、正在上传的文件、终端连接）。herdr 里的 Agent 不受影响，hub 起来后会自己连回来。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Thread" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thread"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "経緯"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线索"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Three forms: https://example.com/extensions/ (an address not ending in .json reads persona-extensions.json under it); github:owner/repo (the one at the repo root; private repos need a token); git:<address>[#branch] (git@host:path.git, ssh://…, https://…; uses the hub machine's own SSH credentials, no token)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three forms: https://example.com/extensions/ (an address not ending in .json reads persona-extensions.json under it); github:owner/repo (the one at the repo root; private repos need a token); git:<address>[#branch] (git@host:path.git, ssh://…, https://…; uses the hub machine's own SSH credentials, no token)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3つの書き方：https://example.com/extensions/（.jsonで終わらない場合はその下のpersona-extensions.jsonを読みます）、github:owner/repo（リポジトリのルートにあるもの。プライベートはトークンが必要）、git:<アドレス>[#ブランチ]（git@host:path.git、ssh://…、https://…。ハブのマシン自身のSSH認証情報を使い、トークンは不要）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三种写法：https://example.com/extensions/（不以 .json 结尾的读它下面的 persona-extensions.json）；github:owner/repo（仓库根目录的那份，私有的要 token）；git:<地址>[#分支]（git@host:path.git、ssh://…、https://…，用 hub 机器自己的 SSH 凭据，不用 token）。"
          }
        }
      },
      "extractionState" : "manual"
    },
    "Three-finger swipe on the trackpad: switch agents in this space (when “Swipe between pages” is set to three fingers in System Settings › Trackpad)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three-finger swipe on the trackpad: switch agents in this space (when “Swipe between pages” is set to three fingers in System Settings › Trackpad)"

          }
        }
      }
    },
    "Every use in this category uses this setting. Leave fields empty to keep the current default. Changing the provider clears the previous model and reasoning effort. Custom model IDs must be supported by the provider." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every use in this category uses this setting. Leave fields empty to keep the current default. Changing the provider clears the previous model and reasoning effort. Custom model IDs must be supported by the provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカテゴリのすべての用途がこの設定を使います。空欄のままにすると現在のデフォルトを使います。プロバイダーを変更すると、以前のモデルと思考レベルはクリアされます。カスタムモデルIDはプロバイダーが対応している必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分类的所有用途统一使用这项配置。留空使用现有默认；更换供应商会清除旧模型和思考强度。自定义模型 ID 需要供应商支持。"
          }
        }
      },
      "extractionState" : "manual"
    },

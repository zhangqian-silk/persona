    "Unpin Confirmation Message %@ [Leader Actions 6214]" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” returns to Recent. Its open tasks go back to the main chat's supervision; nothing is closed or deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は「最近」に戻ります。進行中のタスクはメインチャットの監督に戻り、終了や削除はされません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」会回到「最近」；还在办的任务交还主对话督办，不会关闭或删除。"
          }
        }
      }
    },

          },
          {
            "id": "c2",
            "icon": "triaged",
            "reported": false
          },
          {
            "id": "c3",
            "icon": "persona",
            "reported": false
          },
          {
            "id": "c4",
            "icon": "reply",
            "reported": false
          }
        ]
      }
    },
    {

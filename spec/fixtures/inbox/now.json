      "zh-Hans": "看过 3 次还没动静，还要跟吗？",
      "ja": "3回確認しても動きがありません。続けますか？"
    },
    "check_due": {
      "en": "Time to look again",
      "zh-Hans": "到了再看的时间",
      "ja": "再確認の時間です"
    },
    "failed": {
      "en": "AI couldn't finish: {reason}",
      "zh-Hans": "AI 没处理完：{reason}",
      "ja": "AIが処理を終えられませんでした：{reason}"

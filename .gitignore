.DS_Store
/server/bin/
# `go build ./cmd/<name>` run in server/ drops the program there.
/server/personad
/server/persona-node
/server/persona-link
/build/
/build-release/
/apple/*.xcodeproj
!/apple/Persona.xcodeproj
/apple/IslandPeer/*.xcodeproj
/apple/build/
*.xcuserstate
xcuserdata/
DerivedData/
__pycache__/
/tmp/
# Root-local isolated checkouts and Node.js dependencies.
/.worktrees/
/node_modules/
florak/
/apple/Config.xcconfig
# Generated when config.json app.carplay_voice is on: the app's entitlements plus the CarPlay voice one (docs/apple/carplay.md).
/apple/PersonaOptIn.entitlements
/apple/PersonaCarPlay.entitlements
# Personal notes for coding agents working in this checkout (machines, accounts); see CLAUDE.md.
/CLAUDE.local.md
/apple/PersonaLink/.build/
/apple/PersonaLink/Input/.build/
# swift test in a local package (apple/Packages/PersonaKit, #2095): its build output, never committed.
/apple/Packages/PersonaCore/build/
/apple/Packages/PersonaCore/Inputs.stamp
/apple/Packages/*/.build/
# The isolation lint is built into /build/isolation-lint (scripts/test/isolation-lint.sh); an editor's index lands here.
/scripts/test/isolation-lint/.build/
/apple/PersonaLink/build/
/build-publish/
/build-publish-site/
/repos/
/server/internal/hub/webdist/*
!/server/internal/hub/webdist/README.md
/server/internal/runtimepkg/dist/*
!/server/internal/runtimepkg/dist/README.md
# A hub run from deploy/docker (docs/operations/docker.md): its secrets and data stay out of the repo.
/deploy/docker/.env
/deploy/docker/data/
/deploy/docker/postgres/
# App Store Connect API keys and asc's repo-local config stay on the machine (docs/operations/release.md "Releasing with asc").
*.p8
/.asc/

